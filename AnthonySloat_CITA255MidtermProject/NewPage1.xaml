<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnthonySloat_CITA255MidtermProject.NewPage1"
             Title="ZEZTZ Driver">
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto, Auto, Auto, Auto, Auto, Auto, Auto"
        Padding="24"
        RowSpacing="14">

            <Label HorizontalOptions="Start" Text="ZEZTZ Driver" Style="{StaticResource TitleLabel}" Grid.Row="2"/>
            <Image Source="zeztz.jpg" HeightRequest="300" WidthRequest="300" Grid.Row="0"/>
            <Label Text="$60.00" Style="{StaticResource PriceLabel}" Grid.Row="3"/>
            <Label Text="Your next mission..." Style="{StaticResource DescriptionLabel}" Grid.Row="4"/>
            <Label Text="Transform with the included Capsem into an invincible agent. Travel through dreams and fight for freedom as Kamen Rider ZEZTZ." Style="{StaticResource DescriptionLabel}" Grid.Row="5"/>
            <Entry Placeholder="Quantity" WidthRequest="700" Grid.Row="6" HorizontalOptions="Start" x:Name="quantityEntry"/>
            <Button Text="Add to cart" WidthRequest="700" Grid.Row="7" Clicked="Button_Clicked"/>
            <Label x:Name="addedLabel" Text="" FontSize="12" TextColor="LightGreen" Grid.Row="8" HorizontalTextAlignment="Center"/>
        </Grid>
    </ScrollView>
</ContentPage>