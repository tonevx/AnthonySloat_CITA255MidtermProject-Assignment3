<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnthonySloat_CITA255MidtermProject.DestinatioPageSample"
             Title="Checkout">
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto, Auto, Auto, Auto, Auto, Auto"
        Padding="24"
        RowSpacing="14">
            <Label Text="Checkout" FontSize="25" FontAttributes="Bold" HorizontalOptions="Start" Grid.Row="0"/>
            <Label Text="Nothing in cart." TextColor="DimGrey" HorizontalTextAlignment="Center" Grid.Row="3"/>
            <Label Text="Total: $0" HorizontalTextAlignment="End" Grid.Row="6"/>
            <Button Text="Check out" HorizontalOptions="End" Grid.Row="7"/>
        </Grid>
    </ScrollView>
</ContentPage>