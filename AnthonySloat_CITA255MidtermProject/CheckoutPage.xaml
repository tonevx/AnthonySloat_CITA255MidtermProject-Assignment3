<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnthonySloat_CITA255MidtermProject.CheckoutPage"
             Title="Checkout">
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto, Auto, Auto, Auto, Auto, Auto"
        Padding="24"
        RowSpacing="14">
            <VerticalStackLayout>
                <Border Grid.Row="1" StrokeThickness="1" Padding="4">
                <CollectionView x:Name="CartList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}" FontSize="20" HorizontalTextAlignment="Start" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="Nothing in cart." FontSize="20" HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                </CollectionView>
                </Border>
                <Label x:Name="totalLabel" Grid.Row="2" Text="" FontSize="15" VerticalOptions="End" HorizontalOptions="End"/>
                <Button Grid.Row="6" HorizontalOptions="End" Text="Check out" Clicked="Button_Clicked"/>
                <Label Grid.Row="7" x:Name="endLabel" Text="" FontSize="20" TextColor="LightGreen"/>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>